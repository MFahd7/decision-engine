# ---------------------------------------------------------------------------
# The Decision Engine — environment
#
# Every variable here is OPTIONAL. With an empty .env the app builds, runs,
# passes its tests and demos every feature. Copy this file to `.env.local`
# only if you want the live LLM signal extractor.
# ---------------------------------------------------------------------------

# Enables the LLM claim extractor, which contributes ONE signal per decision:
# a `model`-source signal carrying its own self-reported confidence, which the
# kernel is free to discount like any other. Leave it unset and the extractor
# falls back to a deterministic stub built from the fixture's own text. The
# verdict logic is identical either way — an LLM never decides anything here.
ANTHROPIC_API_KEY=

# Model used by that extractor. Defaults to claude-opus-5.
DECISION_ENGINE_MODEL=claude-opus-5

# Where the append-only, hash-chained audit log is written.
#   file   - ./audit/data/audit.jsonl  (default for local development)
#   memory - process memory, reseeded on boot (default on Vercel and in tests)
AUDIT_STORE=file
